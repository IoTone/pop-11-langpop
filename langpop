#!/bin/sh
# langpop -- run the tutor from anywhere, with any Poplog.
#
#     ./langpop                    the tutor (Japanese; --lang en for English)
#     ./langpop server --port N    the JSON-RPC server
#     ./langpop client ...         the line client
#     ./langpop dump ...           the exporter
#     ./langpop import ...         the importer
#     ./langpop test               every suite, and a nonzero exit if any fails
#     ./langpop --check | --audit | --gap ...               reports
#
# Finds a Poplog in this order: $LANGPOP_POPLOG (the poplog command to
# run), the enclosing Poplog source tree's own ./poplog (which is where
# this directory lives today), then `poplog` on PATH.  Every .p file here
# locates its neighbours from its own path, so the working directory
# does not matter.

here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -n "$LANGPOP_POPLOG" ]; then
    run="$LANGPOP_POPLOG"
elif [ -x "$here/../../poplog" ]; then
    run="$here/../../poplog"
elif command -v poplog >/dev/null 2>&1; then
    run=poplog
else
    echo 'langpop: no Poplog found.' >&2
    echo 'langpop: it needs one from 2026-10-20 or later (lib/json, lib/jsonrpc);' >&2
    echo 'langpop: set LANGPOP_POPLOG to the poplog command, or put poplog on PATH.' >&2
    exit 3
fi

case "$1" in
    server|client|dump|import)
        f="$1.p"; shift ;;
    oracle)
        shift
        for a in "$@"; do
            [ "$a" = --port ] && exec "$run" basepop11 "$here/oracle.p" "$@"
        done
        # No server named: provision a scratch one, so that every oracle
        # run starts from an empty profile and leaves nothing behind.
        port=$(( ($$ % 2000) + 7800 ))
        data=$(mktemp -d "${TMPDIR:-/tmp}/langpop-oracle.XXXXXX")
        # The voice and its cache are machine content, not student state,
        # so the scratch home starts with this machine's copy -- and the
        # listening questions appear wherever the machine can ask them.
        if [ -f "$HOME/.langpop/audio.conf" ]; then
            cp "$HOME/.langpop/audio.conf" "$data/"
            [ -d "$HOME/.langpop/audio" ] && cp -R "$HOME/.langpop/audio" "$data/audio"
        fi
        # A SHORT DAY.  The review ladder and the period are measured in
        # wall-clock days and an oracle run lasts under a minute, so
        # without this nothing that waits a day could ever be exercised:
        # no review would come due and every criterion would read as
        # untested.  200ms a day puts the first review 200ms out and the
        # period at 5.6s, which a full run crosses once or twice.
        "$run" basepop11 "$here/server.p" --port "$port" --data "$data/" \
            --day-ms "${LANGPOP_DAY_MS:-200}" \
            >"$data/server.log" 2>&1 &
        srv=$!
        i=0
        until grep -q serving "$data/server.log" 2>/dev/null; do
            i=$((i+1))
            if [ $i -gt 100 ]; then
                echo "langpop: the server never came up -- see $data/server.log" >&2
                kill "$srv" 2>/dev/null
                exit 3
            fi
            sleep 0.1
        done
        "$run" basepop11 "$here/oracle.p" --port "$port" "$@"
        code=$?
        kill "$srv" 2>/dev/null
        if [ "$code" -eq 0 ]; then rm -rf "$data"
        else echo "langpop: the run is kept at $data" >&2
        fi
        exit "$code" ;;
    test|tests)
        failed=0
        for t in "$here"/tests/test_*.p; do
            # The SUMMARY line, not the last line: the compiler writes
            # its own chatter to the same stream and has been seen to
            # interleave a line of it AFTER the summary, which read as a
            # failure in a suite that had passed.
            out=$("$run" basepop11 "$t" </dev/null 2>&1)
            last=$(printf '%s\n' "$out" | grep '\*\* SUMMARY' | tail -1)
            [ -n "$last" ] || last=$(printf '%s\n' "$out" | tail -1)
            printf '%s: %s\n' "$(basename "$t" .p)" "$last"
            case "$last" in *'ALL PASS'*) ;; *) failed=1 ;; esac
        done
        exit $failed ;;
    *)
        f='langpop.p' ;;
esac

exec "$run" basepop11 "$here/$f" "$@"
